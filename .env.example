# Optional. docker compose runs without a .env because every setting has a default;
# copy this file to .env only to override some of them. .env is gitignored.

# Postgres
POSTGRES_USER=ptcgp
POSTGRES_PASSWORD=changeme
POSTGRES_DB=ptcgp_tracker

# Pinned pokemon-tcg-pocket-cards dataset tag.
# Must match the "pokemon-tcg-pocket-cards" npm dependency version in frontend/package.json.
CARD_DATA_REPO_TAG=v5.3.1

# Comma-separated emails that get the admin role (promoted on backend startup, and on
# registration). Only ever promotes; admins can also be promoted/demoted from the settings page.
ADMIN_EMAILS=

# Outgoing email (forgot-password links). docker-compose.yml already points these at the
# bundled Mailpit container by default — a fake SMTP server, viewable at localhost:8025 — so
# these only need setting to test against a real provider from local dev.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENABLE_SSL=true
