# Copy this file to .env and fill in local values. .env is gitignored.

# Postgres
POSTGRES_USER=ptcgp
POSTGRES_PASSWORD=changeme
POSTGRES_DB=ptcgp_tracker

# Pinned pokemon-tcg-pocket-cards dataset tag.
# Must match the "pokemon-tcg-pocket-cards" npm dependency version in frontend/package.json.
CARD_DATA_REPO_TAG=v5.3.1

# Comma-separated emails that get the admin role (promoted on backend startup, and on
# registration). Only ever promotes; admins can also be promoted/demoted from the settings page.
ADMIN_EMAILS=
